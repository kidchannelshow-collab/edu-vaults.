# Copy to `.env.seed` and fill in. `.env.seed` is gitignored; this template is not.
#   cp .env.seed.example .env.seed
#   npm run seed

# --- Admin account (must be role=admin AND status=active) --------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# --- Files ------------------------------------------------------------------
# Absolute or project-relative paths. PDF is required; previews are optional but
# this is the whole point of seeding — supply both to exercise the full pipeline.
PDF_PATH="./path/to/material.pdf"
PREVIEW1_PATH="./path/to/page-1.png"
PREVIEW2_PATH="./path/to/page-2.png"

# --- Material metadata (all optional; defaults shown) -----------------------
MATERIAL_TITLE="EduVault Flagship Study Guide"
MATERIAL_DESCRIPTION=""
MATERIAL_CATEGORY="General"      # General | JUPEB
MATERIAL_PRICE="1500"
MATERIAL_READING_MINUTES="15"
MATERIAL_PUBLISHED="true"        # false saves as a draft the storefront won't show

# Supabase URL + publishable key are read from .env automatically. Override here
# only if you need to seed a different project.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY=""
