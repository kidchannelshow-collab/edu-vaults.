# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for student authentication and data
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT PUT THESE IN THIS FILE
# ---------------------------------------------------------------------------
# Everything below is read by the Edge Functions via Deno.env.get(...) and must
# be set with `supabase secrets set`, never committed and never placed in a
# VITE_* variable (those are inlined into the client bundle and are public).
#
#   supabase secrets set \
#     FLW_SECRET_KEY=...       # Flutterwave SECRET key (FLWSECK-...)
#     FLW_WEBHOOK_SECRET=...   # the hash set in the Flutterwave webhook config
#
# Consumed by:
#   create-payment        -> FLW_SECRET_KEY        (initialises the charge)
#   verify-payment        -> FLW_SECRET_KEY        (verifies, grants entitlement)
#   flutterwave-webhook   -> FLW_WEBHOOK_SECRET    (verifies the callback hash)
#
# A Flutterwave PUBLIC key (FLWPUBK-...) is safe in the client by design, but it
# is only needed for the inline/popup checkout. This app uses the hosted redirect
# flow, so no public key is required client-side. If that ever changes, add it as
# VITE_FLW_PUBLIC_KEY here and read it with import.meta.env.

# No additional client-side variables are required for payments. Checkout uses the
# create-payment Edge Function, and the manual fallback (Admin → Fulfilment) needs
# no configuration.



